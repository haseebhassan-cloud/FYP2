<!--workstation.xml-->
<mujoco model="ur5_hrc">
    <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81"/>

    <worldbody>
        <camera name="task_view" pos="1.5 -1.5 1.2" euler="1.0 0 0.8"/>
        
        <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="3 3 0.1" rgba="0.8 0.9 0.8 1"/>

        <body name="base" pos="0 0 0.1">
            <geom type="cylinder" size="0.05 0.05" rgba="0.5 0.5 0.5 1"/>
            
            <body name="shoulder_link" pos="0 0 0.1">
                <geom type="capsule" size="0.04" fromto="0 0 0 0 0.1 0" rgba="0.7 0.7 0.7 1"/>
                
                <body name="upper_arm_link" pos="0 0.1 0">
                    <geom type="capsule" size="0.04" fromto="0 0 0 0 0 0.4" rgba="0.7 0.7 0.7 1"/>
                    
                    <body name="forearm_link" pos="0 0 0.4">
                        <joint name="elbow_joint" type="hinge" axis="0 1 0" limited="false" damping="0.1" armature="0.05"/>
                        <geom name="robot_effector" type="capsule" size="0.04" fromto="0 0 0 0.3 0 0" rgba="1 0 0 1"/>
                    </body>
                </body>
            </body>
        </body>

        <body name="human" pos="0.25 -0.4 0.3"> 
            <joint name="human_x" type="slide" axis="0 1 0" damping="0.1"/>
            <geom name="human_geom" type="box" size="0.05 0.05 0.05" rgba="0 1 0 1" contype="0" conaffinity="0"/>
        </body>
    </worldbody>

    <actuator>
        <velocity joint="elbow_joint" kv="150" gear="1" ctrlrange="-5 5"/>
        <velocity joint="human_x" kv="50" gear="1" ctrlrange="-5 5"/>
    </actuator>
</mujoco>
